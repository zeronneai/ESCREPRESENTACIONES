# URL pública del sitio (para SEO, sitemap y datos estructurados)
NEXT_PUBLIC_SITE_URL=https://elsauz.com

# WhatsApp de atención general (formato internacional sin + ni espacios)
NEXT_PUBLIC_WHATSAPP_NUMBER=526144246200

# Envío de cotizaciones por correo con Resend (opcional).
# Si RESEND_API_KEY está vacío, la cotización solo se registra en consola del servidor.
RESEND_API_KEY=
QUOTE_FROM_EMAIL=cotizaciones@elsauz.com
QUOTE_TO_EMAIL=informacion@elsauz.com

# Leads en el portal interno de cotizaciones (opcional, solo servidor).
# Cada solicitud del formulario crea un lead "Sitio web" en esccotizaciones.vercel.app > Leads.
# PORTAL_LEADS_SECRET debe ser igual a LEADS_WEBHOOK_SECRET del portal. Nunca con prefijo NEXT_PUBLIC_.
PORTAL_LEADS_URL=https://esccotizaciones.vercel.app/api/leads/entrada
PORTAL_LEADS_SECRET=
